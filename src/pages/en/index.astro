---
import Layout from '../../layouts/Layout.astro';
import { data } from '../../data/info.js';

const lang = "en";
const t = data[lang];
---

<Layout title={`${t.infoPersonal.nombre_corto} | Portfolio`} lang={lang}>
    <header class="navbar">
        <div class="container navbar__content">
            <a href={`/${lang}#inicio`} class="navbar__brand">
                {t.infoPersonal.nombre_corto}
            </a>

            <nav class="navbar__links">
                <a href={`/${lang}#inicio`}>{t.nav.inicio}</a>
                <a href={`/${lang}#proyectos`}>{t.nav.proyectos}</a>
                <a href={`/${lang}#habilidades`}>{t.nav.habilidades}</a>
                <a href={`/${lang}#formacion`}>{t.nav.formacion}</a>
                <a href={`/${lang}#contacto`}>{t.nav.contacto}</a>
                
                <div class="controls">
                    <button id="themeToggle" class="theme-toggle" aria-label="Toggle theme">🌓</button>
                    <a href="/" class="lang-toggle">ES</a>
                </div>
            </nav>
        </div>
    </header>

    <main>
        <!-- Hero Section -->
        <section id="inicio" class="hero">
            <div class="container hero__grid">
                <div class="hero__content">
                    <span class="tag">{t.infoPersonal.tag}</span>
                    <h1>
                        {t.infoPersonal.heroTitle} <span>{t.infoPersonal.heroTitleAccent}</span>.
                    </h1>
                    <p>{t.infoPersonal.descripcion}</p>
                    <div class="hero__actions">
                        <a href={`/${lang}#proyectos`} class="btn btn--primary">{t.nav.proyectos}</a>
                        <a href={t.infoPersonal.github} target="_blank" rel="noopener" class="btn btn--outline">GitHub</a>
                    </div>
                    <div class="hero__stats">
                        {t.infoPersonal.stats.map(stat => (
                            <div>
                                <strong>{stat.val}</strong>
                                <span>{stat.label}</span>
                            </div>
                        ))}
                    </div>
                </div>

                <aside class="profile-card">
                    <div class="profile-img-container">
                        <img src="/perfil.jpeg" alt={t.infoPersonal.nombre} />
                    </div>
                    <h3>{t.infoPersonal.nombre}</h3>
                    <p>{t.infoPersonal.especialidad}</p>
                </aside>
            </div>
        </section>

        <!-- About Section -->
        <section class="section">
            <div class="container section__grid">
                <h2 class="section__title">{t.infoPersonal.aboutTitle}</h2>
                <div class="section__text">
                    <p>{t.infoPersonal.aboutText}</p>
                </div>
            </div>
        </section>

        <!-- Projects Section -->
        <section id="proyectos" class="section">
            <div class="container">
                <h2 class="section__title">{t.infoPersonal.projectsTitle}</h2>
                <div class="projects-grid">
                    {t.proyectos.map((proyecto) => (
                        <article class="project-card">
                            <span class="tag">{proyecto.estado}</span>
                            <h3>{proyecto.nombre}</h3>
                            <p class="project-card__description">{proyecto.descripcion}</p>
                            <div class="project-card__stack">
                                {proyecto.tecnologias.map((tecnologia) => (
                                    <span>{tecnologia}</span>
                                ))}
                            </div>
                            <a href={proyecto.github} target="_blank" rel="noopener" class="project-card__link">
                                View Code →
                            </a>
                        </article>
                    ))}
                </div>
            </div>
        </section>

        <!-- Skills Section -->
        <section id="habilidades" class="section">
            <div class="container">
                <h2 class="section__title">{t.infoPersonal.skillsTitle}</h2>
                <div class="skills-grid">
                    {t.habilidades.map((habilidad) => (
                        <article class="skill-card">
                            <h3>{habilidad.grupo}</h3>
                            <div class="skill-card__items">
                                {habilidad.items.map((item) => (
                                    <span>{item}</span>
                                ))}
                            </div>
                        </article>
                    ))}
                </div>
            </div>
        </section>

        <!-- Education & Certs -->
        <section id="formacion" class="section">
            <div class="container">
                <h2 class="section__title">{t.infoPersonal.educationTitle}</h2>
                <div class="education-grid">
                    <div>
                        <article class="education-card">
                            <span class="tag">University</span>
                            <h3>{t.educacion.carrera}</h3>
                            <p>{t.educacion.universidad}</p>
                            <p>{t.educacion.periodo} | {t.educacion.estado}</p>
                        </article>
                        
                        <article class="education-card">
                            <span class="tag">Languages</span>
                            {t.idiomas.map((idioma) => (
                                <p><strong>{idioma.nombre}:</strong> {idioma.nivel}</p>
                            ))}
                        </article>
                    </div>

                    <div>
                        {t.certificaciones.map((cert) => (
                            <article class="cert-card">
                                <h3>{cert.nombre}</h3>
                                <p>{cert.institucion} • {cert.fecha}</p>
                            </article>
                        ))}
                    </div>
                </div>
            </div>
        </section>

        <!-- Contact Section -->
        <section id="contacto" class="section">
            <div class="container">
                <h2 class="section__title">{t.infoPersonal.contactTitle}</h2>
                <p style="margin-bottom: 2rem; color: var(--text-secondary);">{t.infoPersonal.contactDesc}</p>
                <div class="hero__actions">
                    <a href={`mailto:${t.infoPersonal.email}`} class="btn btn--primary">Email</a>
                    <a href={t.infoPersonal.linkedin} target="_blank" rel="noopener" class="btn btn--outline">LinkedIn</a>
                    <a href={t.infoPersonal.github} target="_blank" rel="noopener" class="btn btn--outline">GitHub</a>
                </div>
            </div>
        </section>
    </main>

    <footer>
        <div class="container">
            <p>© 2026 {t.infoPersonal.nombre_corto}. {t.infoPersonal.footer}</p>
        </div>
    </footer>
</Layout>

<script>
    const themeToggle = document.getElementById('themeToggle');
    themeToggle?.addEventListener('click', () => {
        const currentTheme = document.documentElement.getAttribute('data-theme');
        const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', newTheme);
        localStorage.setItem('theme', newTheme);
    });
</script>
