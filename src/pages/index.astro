---
import Layout from '../layouts/Layout.astro';
import { infoPersonal, proyectos, habilidades, educacion, idiomas, certificaciones } from '../data/info.js';
---

<Layout title={`${infoPersonal.nombre_corto} | Portafolio`}>
    <header class="navbar">
        <div class="container navbar__content">
            <a href="#inicio" class="navbar__brand">
                {infoPersonal.nombre_corto}
            </a>

            <button class="navbar__toggle" id="menuToggle" aria-label="Abrir menú">☰</button>

            <nav class="navbar__links" id="navMenu">
                <a href="#inicio">Inicio</a>
                <a href="#proyectos">Proyectos</a>
                <a href="#habilidades">Habilidades</a>
                <a href="#formacion">Formación</a>
                <a href="#contacto">Contacto</a>
            </nav>
        </div>
    </header>

    <main>
        <!-- Hero Section -->
        <section id="inicio" class="hero">
            <div class="container hero__grid">
                <div class="hero__content">
                    <span class="tag">Junior Software Developer</span>
                    <h1>
                        Building robust systems with <span>Python & Django</span>.
                    </h1>
                    <p>{infoPersonal.descripcion}</p>
                    <div class="hero__actions">
                        <a href="#proyectos" class="btn btn--primary">Ver proyectos</a>
                        <a href={infoPersonal.github} target="_blank" rel="noopener" class="btn btn--outline">GitHub</a>
                    </div>
                    <div class="hero__stats">
                        <div>
                            <strong>4+</strong>
                            <span>Proyectos</span>
                        </div>
                        <div>
                            <strong>Backend</strong>
                            <span>Django Specialist</span>
                        </div>
                        <div>
                            <strong>QA</strong>
                            <span>Quality Focused</span>
                        </div>
                    </div>
                </div>

                <aside class="profile-card">
                    <div class="profile-img-container">
                        <img src="/perfil.jpeg" alt={infoPersonal.nombre} />
                    </div>
                    <h3>{infoPersonal.nombre}</h3>
                    <p>{infoPersonal.especialidad}</p>
                </aside>
            </div>
        </section>

        <!-- About Section -->
        <section class="section">
            <div class="container section__grid">
                <h2 class="section__title">Ingeniería con propósito.</h2>
                <div class="section__text">
                    <p>
                        Soy Ingeniero en Computación y Desarrollador de Software Junior enfocado en
                        backend y sistemas administrativos que resuelven problemas reales.
                    </p>
                    <p>
                        Mi stack principal incluye <strong>Python, Django, y SQL</strong>. Me apasiona construir arquitecturas limpias y procesos que sean útiles y confiables.
                    </p>
                </div>
            </div>
        </section>

        <!-- Projects Section -->
        <section id="proyectos" class="section">
            <div class="container">
                <h2 class="section__title">Proyectos destacados</h2>
                <div class="projects-grid">
                    {proyectos.map((proyecto) => (
                        <article class="project-card">
                            <span class="tag">{proyecto.estado}</span>
                            <h3>{proyecto.nombre}</h3>
                            <p class="project-card__description">{proyecto.descripcion}</p>
                            <div class="project-card__stack">
                                {proyecto.tecnologias.map((tecnologia) => (
                                    <span>{tecnologia}</span>
                                ))}
                            </div>
                            <a href={proyecto.github} target="_blank" rel="noopener" class="project-card__link">
                                Ver código →
                            </a>
                        </article>
                    ))}
                </div>
            </div>
        </section>

        <!-- Skills Section -->
        <section id="habilidades" class="section">
            <div class="container">
                <h2 class="section__title">Stack técnico</h2>
                <div class="skills-grid">
                    {habilidades.map((habilidad) => (
                        <article class="skill-card">
                            <h3>{habilidad.grupo}</h3>
                            <div class="skill-card__items">
                                {habilidad.items.map((item) => (
                                    <span>{item}</span>
                                ))}
                            </div>
                        </article>
                    ))}
                </div>
            </div>
        </section>

        <!-- Education & Certs -->
        <section id="formacion" class="section">
            <div class="container">
                <h2 class="section__title">Formación y Certificaciones</h2>
                <div class="education-grid">
                    <div>
                        <article class="education-card">
                            <span class="tag">Universidad</span>
                            <h3>{educacion.carrera}</h3>
                            <p>{educacion.universidad}</p>
                            <p>{educacion.periodo} | {educacion.estado}</p>
                        </article>
                        
                        <article class="education-card">
                            <span class="tag">Idiomas</span>
                            {idiomas.map((idioma) => (
                                <p><strong>{idioma.nombre}:</strong> {idioma.nivel}</p>
                            ))}
                        </article>
                    </div>

                    <div>
                        {certificaciones.map((cert) => (
                            <article class="cert-card">
                                <h3>{cert.nombre}</h3>
                                <p>{cert.institucion} • {cert.fecha}</p>
                            </article>
                        ))}
                    </div>
                </div>
            </div>
        </section>

        <!-- Contact Section -->
        <section id="contacto" class="section">
            <div class="container">
                <h2 class="section__title">Hablemos.</h2>
                <div class="hero__actions">
                    <a href={`mailto:${infoPersonal.email}`} class="btn btn--primary">Email</a>
                    <a href={infoPersonal.linkedin} target="_blank" rel="noopener" class="btn btn--outline">LinkedIn</a>
                    <a href={infoPersonal.github} target="_blank" rel="noopener" class="btn btn--outline">GitHub</a>
                </div>
            </div>
        </section>
    </main>

    <footer>
        <div class="container">
            <p>© 2026 {infoPersonal.nombre_corto}. Built with Astro.</p>
        </div>
    </footer>
</Layout>
