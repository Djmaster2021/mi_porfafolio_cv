---
import Layout from '../layouts/Layout.astro';
import { data } from '../data/info.js';

const lang = "es";
const t = data[lang];
---

<Layout title={`${t.infoPersonal.nombre_corto} | Portafolio`} lang={lang}>
    <header class="navbar">
        <div class="container navbar__content">
            <a href="#inicio" class="navbar__brand">
                {t.infoPersonal.nombre_corto}
            </a>

            <nav class="navbar__links">
                <a href="#inicio">{t.nav.inicio}</a>
                <a href="#proyectos">{t.nav.proyectos}</a>
                <a href="#habilidades">{t.nav.habilidades}</a>
                <a href="#formacion">{t.nav.formacion}</a>
                <a href="#contacto">{t.nav.contacto}</a>
                
                <div class="controls">
                    <button id="themeToggle" class="theme-toggle" aria-label="Toggle theme">
                        <span id="themeIcon">🌓</span>
                    </button>
                    <a href="/en" class="lang-toggle">EN</a>
                </div>
            </nav>
        </div>
    </header>

    <main>
        <!-- Hero Section -->
        <section id="inicio" class="hero bg-white">
            <div class="container hero__content">
                <div class="hero-img">
                    <img src="/perfil.jpeg" alt={t.infoPersonal.nombre} />
                </div>
                <h1>{t.infoPersonal.nombre} <span>{t.infoPersonal.especialidad}</span></h1>
                <p style="margin: 2rem auto;">{t.infoPersonal.descripcion}</p>
                <div class="hero__actions" style="justify-content: center;">
                    <a href="#proyectos" class="btn btn--primary">Explorar mi trabajo</a>
                </div>
            </div>

            <!-- Divider to Cream -->
            <div class="divider divider-bottom">
                <svg data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
                    <path d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z" class="shape-fill"></path>
                </svg>
            </div>
        </section>

        <!-- About / Vision Section -->
        <section class="bg-cream">
            <div class="container">
                <h2 style="text-align: center; margin-bottom: 4rem;">{t.infoPersonal.aboutTitle}</h2>
                <p style="font-family: 'Playfair Display', serif; font-size: 2.5rem; text-align: center; max-width: 900px; margin: 0 auto; line-height: 1.3;">
                    "{t.infoPersonal.aboutText}"
                </p>
            </div>
        </section>

        <!-- Projects Section -->
        <section id="proyectos" class="bg-white">
             <!-- Divider from Cream -->
             <div class="divider divider-top">
                <svg data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none" style="transform: rotate(180deg);">
                    <path d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z" class="shape-fill"></path>
                </svg>
            </div>

            <div class="container">
                <h2 style="margin-bottom: 6rem; text-align: center;">{t.infoPersonal.projectsTitle}</h2>
                
                <div class="projects-fluid-list">
                    {t.proyectos.map((proyecto) => (
                        <article class="project-fluid-item">
                            <div class="project-meta-elegant">
                                <span class="project-type">{proyecto.tipo}</span>
                                <h3>{proyecto.nombre}</h3>
                                <p style="font-weight: 600; color: var(--text-muted);">{proyecto.periodo}</p>
                            </div>
                            
                            <div class="project-content">
                                <p>{proyecto.descripcion}</p>
                                <div style="margin-bottom: 1.5rem; padding-left: 1rem; border-left: 2px solid var(--accent-brand);">
                                    <strong style="display: block; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent-brand);">Impacto clave</strong>
                                    {proyecto.impacto}
                                </div>
                                <div class="project-tag-list">
                                    {proyecto.tecnologias.map(tech => <span class="project-tag">{tech}</span>)}
                                </div>
                            </div>
                        </article>
                    ))}
                </div>
            </div>
        </section>

        <!-- Skills Section -->
        <section id="habilidades" class="bg-cream">
            <div class="container">
                <h2 style="margin-bottom: 4rem; text-align: center;">{t.infoPersonal.skillsTitle}</h2>
                <div class="skills-fluid-grid">
                    {t.habilidades.map((habilidad) => (
                        <div class="skill-cat">
                            <h3>{habilidad.grupo}</h3>
                            <ul class="skill-list-minimal">
                                {habilidad.items.map((item) => (
                                    <li>{item}</li>
                                ))}
                            </ul>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- Education & Certs -->
        <section id="formacion" class="bg-white">
            <div class="container">
                <h2 style="margin-bottom: 4rem; text-align: center;">{t.infoPersonal.educationTitle}</h2>
                <div class="project-fluid-item" style="margin-bottom: 0;">
                    <div class="project-meta-elegant">
                        <span class="project-type">Título Universitario</span>
                        <h3>{t.educacion.carrera}</h3>
                        <p>{t.educacion.universidad}</p>
                        <p class="project-type" style="color: var(--text-muted); margin-top: 1rem;">{t.educacion.periodo} • {t.educacion.estado}</p>
                    </div>
                    
                    <div class="project-content">
                        <h3 style="margin-bottom: 2rem;">Certificaciones y Lenguajes</h3>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;">
                            <div>
                                <h4 style="margin-bottom: 1rem; font-weight: 800;">Idiomas</h4>
                                {t.idiomas.map(lang => (
                                    <p style="margin-bottom: 0.5rem;"><strong>{lang.nombre}:</strong> {lang.nivel}</p>
                                ))}
                            </div>
                            <div>
                                <h4 style="margin-bottom: 1rem; font-weight: 800;">Cursos clave</h4>
                                {t.certificaciones.slice(0, 3).map(cert => (
                                    <p style="font-size: 0.9rem; margin-bottom: 0.5rem;">• {cert.nombre}</p>
                                ))}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Contact Section -->
        <section id="contacto" class="bg-cream">
            <div class="container contact-fluid">
                <h2 style="font-size: 4rem; margin-bottom: 2rem;">{t.infoPersonal.contactTitle}</h2>
                <p style="font-size: 1.5rem; color: var(--text-secondary);">{t.infoPersonal.contactDesc}</p>
                
                <div class="contact-links-minimal">
                    <a href={`mailto:${t.infoPersonal.email}`} class="contact-link-item">Email</a>
                    <a href={`tel:${t.infoPersonal.telefono}`} class="contact-link-item">Teléfono</a>
                    <a href={t.infoPersonal.linkedin} target="_blank" class="contact-link-item">LinkedIn</a>
                    <a href={t.infoPersonal.github} target="_blank" class="contact-link-item">GitHub</a>
                </div>
            </div>
        </section>
    </main>

    <footer>
        <div class="container" style="padding: 4rem 0; border-top: 1px solid var(--border);">
            <p>© 2026 {t.infoPersonal.nombre_corto}. {t.infoPersonal.footer}</p>
        </div>
    </footer>
</Layout>

<script>
    const themeToggle = document.getElementById('themeToggle');
    const themeIcon = document.getElementById('themeIcon');
    
    const updateIcon = (theme) => {
        if (themeIcon) {
            themeIcon.innerText = theme === 'dark' ? '☀️' : '🌙';
        }
    };

    const currentTheme = document.documentElement.getAttribute('data-theme');
    updateIcon(currentTheme);

    themeToggle?.addEventListener('click', () => {
        const currentTheme = document.documentElement.getAttribute('data-theme');
        const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', newTheme);
        localStorage.setItem('theme', newTheme);
        updateIcon(newTheme);
    });
</script>
